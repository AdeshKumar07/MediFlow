# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ───────────────────────────────────────────────────────────────────
# Local:   mongodb://localhost:27017/mediflow
# Atlas:   mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mediflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/mediflow

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_byte_random_hex_string
JWT_REFRESH_SECRET=replace_with_different_64_byte_random_hex_string
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# Dev:  http://localhost:5173
# Prod: https://mediflow.vercel.app,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Razorpay (Payment Gateway) ────────────────────────────────────────────────
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET

# ─── Swagger Docs ──────────────────────────────────────────────────────────────
# Set to true to enable /api/docs in production (not recommended for public APIs)
DEBUG_DOCS=false
